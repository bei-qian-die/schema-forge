{
  "name": "@schema-forge/core",
  "version": "1.0.0",
  "type": "module",
  "description": "Framework-agnostic schema compiler: expressions, dependency graph, precise propagation, validation and JSON Patch history.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
